# Cockpit relay (à déposer dans le même dossier que relay.php et index.html).

# 1. Transmettre l'en-tête Authorization à PHP (souvent absente en CGI/FPM mutualisé).
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
</IfModule>
SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1

# 2. PWA : ne pas mettre en cache la coquille (mises à jour immédiates).
<IfModule mod_headers.c>
    <FilesMatch "(index\.html|sw\.js|manifest\.webmanifest)$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
</IfModule>

# 3. index.html sert de page par défaut du dossier.
DirectoryIndex index.html index.php
