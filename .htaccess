# Cockpit — le docroot est le dépôt Git (index.html, relay.php, deploy.php à la racine).

# 1. Transmettre l'en-tête Authorization à PHP (souvent absente en CGI/FPM mutualisé).
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
</IfModule>
SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1

# 2. PWA : ne pas mettre en cache la coquille (mises à jour immédiates).
<IfModule mod_headers.c>
    <FilesMatch "(index\.html|sw\.js|manifest\.webmanifest|version\.json|prisme-version\.json)$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
</IfModule>

# 3. index.html sert de page par défaut.
DirectoryIndex index.html index.php

# 4. Le dépôt Git et les sources macOS vivent dans le même dossier : on les masque.
<IfModule mod_rewrite.c>
    RewriteRule (^|/)\.git(/|$)               - [F,L]
    RewriteRule ^(Sources|tools|icon|docs)(/|$) - [F,L]
    RewriteRule \.(swift|sh|resolved)$        - [F,L]
    RewriteRule ^(deploy\.config|config)\.php$ - [F,L]
</IfModule>
