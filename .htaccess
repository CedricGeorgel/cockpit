# Cockpit — le docroit est le dépôt Git (index.html, relay.php, deploy.php à la racine).

# 1. Transmettre l'en-tête Authorization à PHP (souvent absente en CGI/FPM mutualisé).
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
</IfModule>
SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1

# 2. PWA : ne pas mettre en cache la coquille (mises à jour immédiates).
<IfModule mod_headers.c>
    <FilesMatch "(index\.html|sw\.js|manifest\.webmanifest|version\.json)$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
</IfModule>

# 3. index.html sert de page par défaut du dossier.
DirectoryIndex index.html index.php

# 4. Le dépôt et l'app macOS vivent dans le même dossier que le site :
#    on masque tout ce qui n'est pas la PWA / le relais.
RedirectMatch 404 (?i)/\.git
RedirectMatch 404 (?i)^/(Sources|tools|icon|docs|\.build|Cockpit\.app)(/|$)
<FilesMatch "(?i)(^config\.php$|^deploy\.config\.php$|^init\.php$|\.(swift|sh|resolved)$|^Package\.swift$|^\.git)">
    <IfModule mod_authz_core.c>Require all denied</IfModule>
    <IfModule !mod_authz_core.c>Deny from all</IfModule>
</FilesMatch>
