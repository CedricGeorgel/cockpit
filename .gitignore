# --- macOS / Swift build ---
.build/
build/
dist/
DerivedData/
*.xcodeproj
.DS_Store
Cockpit.app/
Cockpit [0-9]*.app/

# --- artefacts d'empaquetage (régénérés par package.sh) ---
# Cockpit-<version>.dmg est ignoré ; Cockpit.dmg (nom stable) est versionné
# pour que la landing le serve automatiquement après deploy.php.
*.dmg
!Cockpit.dmg
cockpit-deploy.zip

# --- serveur : secrets & données runtime (jamais committés) ---
config.php
deploy.config.php
init.php
data/*
!data/.htaccess

# --- divers ---
*.log
.env
