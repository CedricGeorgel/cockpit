# --- macOS / Swift build ---
.build/
build/
dist/
DerivedData/
*.xcodeproj
.DS_Store
Cockpit.app/
Cockpit [0-9]*.app/

# --- artefacts d'empaquetage (régénérés par package.sh) ---
# Cockpit-<version>.dmg est ignoré ; les DMG au nom stable (Cockpit.dmg,
# Prisme.dmg) sont versionnés pour que la landing les serve après deploy.php.
# (pas de commentaire en fin de ligne : ça casse la négation gitignore)
*.dmg
!Cockpit.dmg
!Prisme.dmg
cockpit-deploy.zip

# --- serveur : secrets & données runtime (jamais committés) ---
config.php
deploy.config.php
init.php
data/*
!data/.htaccess

# --- divers ---
*.log
.env
