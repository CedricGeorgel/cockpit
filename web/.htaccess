# Cockpit relay (à déposer dans le même dossier que relay.php et index.html).

# 1. Transmettre l'en-tête Authorization à PHP (souvent absente en CGI/FPM mutualisé).
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
</IfModule>
SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1

# 2. PWA : ne pas mettre en cache la coquille (mises à jour immédiates).
<IfModule mod_headers.c>
    <FilesMatch "(index\.html|sw\.js|manifest\.webmanifest|version\.json)$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
</IfModule>

# 3. index.html sert de page par défaut du dossier.
DirectoryIndex index.html index.php

# 4. Ne jamais servir le dépôt Git, les sources Swift ni les configs
#    (défense en profondeur : normalement .git est hors du docroot).
RedirectMatch 404 /\.git
<FilesMatch "(^config\.php$|^deploy\.config\.php$|^init\.php$|\.(swift|sh|md)$|^Package\.(swift|resolved)$)">
    <IfModule mod_authz_core.c>Require all denied</IfModule>
    <IfModule !mod_authz_core.c>Deny from all</IfModule>
</FilesMatch>
<IfModule mod_alias.c>
    RedirectMatch 404 ^/(Sources|tools|icon|docs|\.build)(/|$)
</IfModule>
